[Unit]
Description=ScannerServer – SANE web UI
After=network.target

[Service]
Type=simple
User=scanner
Group=scanner
WorkingDirectory=/opt/scannerserver
Environment="SCAN_DIR=/srv/scans"
ExecStart=/opt/scannerserver/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
