[Unit]
Description=ScannerServer – SANE web UI
After=network.target

[Service]
Type=simple
User=danielfranzen
WorkingDirectory=/home/danielfranzen/dev/scannerserver
Environment="SCAN_DIR=/home/danielfranzen/scans"
ExecStart=/home/danielfranzen/dev/scannerserver/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
